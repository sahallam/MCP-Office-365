{
  "name": "@office365/mcp-server",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for Microsoft Office 365 integration",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "office365-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "office365",
    "microsoft-graph",
    "outlook",
    "onedrive",
    "sharepoint",
    "teams",
    "excel",
    "ai"
  ],
  "author": "Steven Hallam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahallam/MCP-Office-365.git"
  },
  "bugs": {
    "url": "https://github.com/sahallam/MCP-Office-365/issues"
  },
  "homepage": "https://github.com/sahallam/MCP-Office-365#readme",
  "dependencies": {
    "@azure/msal-node": "^2.15.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.15.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
