# Microsoft Entra ID Application Configuration (formerly Azure Active Directory)
# Get these values from https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade

# Your Microsoft Entra ID tenant ID
TENANT_ID=your-tenant-id

# Your application (client) ID
CLIENT_ID=your-client-id

# Authentication mode: 'app-only' or 'delegated'
# - app-only: Use client credentials (requires CLIENT_SECRET and USER_PRINCIPAL_NAME/USER_ID)
# - delegated: Use device code flow for user authentication (supports Teams, OneNote)
AUTH_MODE=delegated

# Your client secret (application password) - Required for app-only mode
CLIENT_SECRET=your-client-secret

# User principal name - Required for app-only mode
USER_PRINCIPAL_NAME=user@yourdomain.com

# Optional: Specific user ID to act on behalf of (for app-only mode)
USER_ID=

# Optional: Path to store cached tokens (for delegated mode)
# Default: ~/.office365-mcp-token-cache.json (in user's home directory)
# TOKEN_CACHE_PATH=/custom/path/to/token-cache.json

# Optional: Custom encryption key for token cache (recommended for production)
# Generate with: openssl rand -hex 32
# This should be a 64-character hex string (32 bytes)
# If not set, encryption key is derived from hostname and username
# TOKEN_ENCRYPTION_KEY=

# Graph API endpoint (usually not needed to change)
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
