# Microsoft Entra ID Application Configuration (formerly Azure Active Directory)
# Get these values from https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade

# Your Microsoft Entra ID tenant ID
TENANT_ID=your-tenant-id

# Your application (client) ID
CLIENT_ID=your-client-id

# Your client secret (application password)
CLIENT_SECRET=your-client-secret

# Optional: User principal name for delegated permissions
USER_PRINCIPAL_NAME=user@yourdomain.com

# Optional: Specific user ID to act on behalf of
USER_ID=

# Graph API endpoint (usually not needed to change)
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
